{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "redirects": [
    { "source": "/buildings", "destination": "/building-reports", "permanent": true },
    { "source": "/buildings/:slug/report", "destination": "/building-reports/:slug", "permanent": true },
    { "source": "/buy", "destination": "/buyer-advisory", "permanent": true },
    { "source": "/strategy", "destination": "/buyer-advisory", "permanent": true },
    { "source": "/buy-sell", "destination": "/buyer-advisory", "permanent": true },
    { "source": "/reverse-buyer-origination", "destination": "/buyer-advisory", "permanent": true },
    { "source": "/executive-relocation", "destination": "/services/executive-relocation-nyc", "permanent": true },
    { "source": "/corporate-relocation", "destination": "/services/corporate-relocation-buyers-nyc", "permanent": true },
    { "source": "/senior-downsizing", "destination": "/services/retiree-senior-home-buyers-nyc", "permanent": true },
    { "source": "/school-district-planning", "destination": "/services/school-district-planning-nyc", "permanent": true },
    { "source": "/military-relocation", "destination": "/services/military-relocation-nyc", "permanent": true },
    { "source": "/physician-relocation", "destination": "/services/physician-relocation-nyc", "permanent": true },
    { "source": "/finance-relocation", "destination": "/services/finance-hedge-fund-relocation-nyc", "permanent": true },
    { "source": "/pet-friendly-moves", "destination": "/services/pet-friendly-moves-nyc", "permanent": true },
    { "source": "/new-york-market", "destination": "/building-reports/neighborhood-guides", "permanent": true },
    { "source": "/intelligence", "destination": "/building-reports/market-briefs", "permanent": true },
    { "source": "/perspectives", "destination": "/insights", "permanent": true },
    { "source": "/perspectives/reports/:slug", "destination": "/insights/reports/:slug", "permanent": true },
    { "source": "/perspectives/:slug", "destination": "/insights/:slug", "permanent": true },
    { "source": "/lease", "destination": "/contact", "permanent": true },
    { "source": "/sell", "destination": "/contact", "permanent": true },
    { "source": "/profile", "destination": "/account", "permanent": true },
    { "source": "/reverse-seller-architecture", "destination": "/contact", "permanent": true },
    { "source": "/real-estate", "destination": "/building-reports", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
