# Agent Kammer — environment variables (sanitized template for audit)
# Copy to .env or .env.local and fill in values. Never commit real secrets.

# Server
PORT=
NODE_ENV=

# Database (Neon Postgres)
DATABASE_URL=

# Admin portal (required in production)
ADMIN_USER=
ADMIN_PASS=

# Email — Resend (preferred) or SMTP fallback
RESEND_API_KEY=
EMAIL_USER=
EMAIL_PASS=
CONTACT_INBOX=
CONTACT_FALLBACK_INBOX=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI / Decision Guide
XAI_API_KEY=
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
DECISION_GUIDE_MODEL=
OPENAI_MODEL=

# Notion CRM sync (optional — missing vars = no-op)
NOTION_API_KEY=
NOTION_PEOPLE_DATABASE_ID=
NOTION_LEADS_DATABASE_ID=
NOTION_SYNC_ENABLED=

# Attio CRM (optional — missing vars = no-op / queue logs only)
# Docs: docs/integrations/attio.md
# Bootstrap: npx tsx scripts/setup-attio.ts
ATTIO_API_KEY=
ATTIO_WORKSPACE_ID=
ATTIO_PEOPLE_OBJECT_ID=people
ATTIO_HOUSING_RECORD_OBJECT_ID=housing_advisory
ATTIO_TRANSACTIONS_OBJECT_ID=transactions
ATTIO_LEAD_LIST_ID=lead_pipeline
ATTIO_CLIENT_LIST_ID=client_pipeline
ATTIO_DEAL_LIST_ID=deal_pipeline
ATTIO_WEBHOOK_SECRET=
ATTIO_SYNC_ENABLED=true

# Account claim sessions (email + PIN / future magic link)
ACCOUNT_SESSION_SECRET=
ACCOUNT_EMAIL_FROM=

# RentCast market data (optional)
RENTCAST_API_KEY=

# Legacy / hosting
REPLIT_DOMAINS=
